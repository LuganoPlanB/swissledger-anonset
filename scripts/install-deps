#!/usr/bin/env bash
set -Eeuo pipefail

# Install the pinned SwissLedger Foundry release and npm dependencies.
#
# Prerequisites:
#   - Node.js >= 24
#   - npm (via mise or system)
#   - curl and sha256sum (for release asset verification)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

echo "==> Installing pinned SwissLedger Foundry..."
"$PROJECT_DIR/scripts/install-swissledger-toolchain"
make toolchain-info

echo "==> Installing npm dependencies..."
npm ci

echo "==> Setup complete."
