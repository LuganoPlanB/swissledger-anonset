#!/usr/bin/env bash
# Deploy exactly one fresh SemaphoreVerifier -> Semaphore -> Registry stack.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
FORGE="${FORGE_BIN:-$PROJECT_DIR/bin/swissledger-forge}"
CAST="${CAST_BIN:-$PROJECT_DIR/bin/swissledger-cast}"
OUTPUT=${1:?usage: testnet-deploy OUTPUT_JSON}
CHAIN_ID=${SWISSLEDGER_TESTNET_CHAIN_ID:-222}
RPC_URL=${SWISSLEDGER_TESTNET_RPC:-}
EXPECTED_DEPLOYER=${SWISSLEDGER_TESTNET_ADDRESS:-}
PRIVATE_KEY=${SWISSLEDGER_TESTNET_DEPLOY:-}
# These are local operational ceilings (measured use plus generous margin),
# not a claim about a remote testnet block-gas limit.
OPERATIONAL_MAX_GAS_LIMIT=20000000
VERIFIER_GAS_LIMIT=${SWISSLEDGER_TESTNET_VERIFIER_GAS_LIMIT:-1000000}
SEMAPHORE_GAS_LIMIT=${SWISSLEDGER_TESTNET_SEMAPHORE_GAS_LIMIT:-5000000}
REGISTRY_GAS_LIMIT=${SWISSLEDGER_TESTNET_REGISTRY_GAS_LIMIT:-5000000}
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/anonset-testnet.XXXXXX")"

die() { printf 'testnet-deploy: %s\n' "$*" >&2; exit 1; }
cleanup() { rm -rf -- "$TMP_DIR"; }
trap cleanup EXIT HUP INT TERM
[[ $CHAIN_ID == 222 ]] || die 'only SwissLedger testnet chain ID 222 is permitted'
if [[ -z $RPC_URL ]]; then
    die 'missing SWISSLEDGER_TESTNET_RPC (organization variable with credential-free http(s) RPC URL)'
fi
if [[ ! $RPC_URL =~ ^https?://[^/@?#]+ ]] || [[ $RPC_URL =~ ^https?://[^/]*@ ]]; then
    die 'SWISSLEDGER_TESTNET_RPC must be a credential-free http(s) RPC URL'
fi
[[ $PRIVATE_KEY =~ ^0x[0-9a-fA-F]{64}$ ]] || die 'SWISSLEDGER_TESTNET_DEPLOY must be a 32-byte private key'
[[ $EXPECTED_DEPLOYER =~ ^0x[0-9a-fA-F]{40}$ ]] || die 'SWISSLEDGER_TESTNET_ADDRESS must be the expected public deployer address'
for gas_limit in "$VERIFIER_GAS_LIMIT" "$SEMAPHORE_GAS_LIMIT" "$REGISTRY_GAS_LIMIT"; do
    if [[ ! $gas_limit =~ ^[1-9][0-9]*$ ]] || (( gas_limit >= OPERATIONAL_MAX_GAS_LIMIT )); then
        die "gas limit must be a positive integer below the $OPERATIONAL_MAX_GAS_LIMIT operational ceiling"
    fi
done
for binary in "$FORGE" "$CAST" node; do command -v "$binary" >/dev/null 2>&1 || [[ -x $binary ]] || die "required command unavailable: $binary"; done
[[ "$($CAST chain-id --rpc-url "$RPC_URL")" == "$CHAIN_ID" ]] || die "RPC chain ID is not $CHAIN_ID"
DEPLOYER="$($CAST wallet address --private-key "$PRIVATE_KEY")"
[[ $DEPLOYER =~ ^0x[0-9a-fA-F]{40}$ ]] || die 'could not derive deployer address'
[[ ${DEPLOYER,,} == "${EXPECTED_DEPLOYER,,}" ]] || die 'derived deployer does not match SWISSLEDGER_TESTNET_ADDRESS'
BALANCE="$($CAST balance "$DEPLOYER" --rpc-url "$RPC_URL")"
[[ ${BALANCE%% *} != 0 ]] || die 'deployer has no registered testnet balance'
mkdir -p "$(dirname "$OUTPUT")"
"$FORGE" build >/dev/null

deploy() {
    local name=$1 gas_limit=$2 contract=$3 result address tx receipt gas
    shift 3
    result="$TMP_DIR/$name.json"
    local -a command=("$FORGE" create "$contract" --rpc-url "$RPC_URL" --private-key "$PRIVATE_KEY" --legacy --gas-price 0 --gas-limit "$gas_limit" --chain "$CHAIN_ID" --broadcast --json)
    (( $# == 0 )) || command+=(--constructor-args "$@")
    "${command[@]}" >"$result"
    address="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1])); if(!/^0x[0-9a-f]{40}$/i.test(v.deployedTo||""))process.exit(1); process.stdout.write(v.deployedTo)' "$result")" || die "$name returned no deployment address"
    tx="$(node -e 'const v=JSON.parse(require("fs").readFileSync(process.argv[1])); const x=v.transactionHash||v.transaction?.hash||""; if(!/^0x[0-9a-f]{64}$/i.test(x))process.exit(1); process.stdout.write(x)' "$result")" || die "$name returned no transaction hash"
    receipt="$($CAST receipt --json "$tx" --rpc-url "$RPC_URL")"
    gas="$(node -e 'const v=JSON.parse(process.argv[1]); if(v.status!=="0x1"||!v.gasUsed)process.exit(1); process.stdout.write(BigInt(v.gasUsed).toString())' "$receipt")" || die "$name transaction was not successful"
    (( gas < gas_limit )) || die "$name exhausted its explicit gas cap"
    [[ "$($CAST code "$address" --rpc-url "$RPC_URL")" =~ ^0x[0-9a-fA-F]{2,}$ ]] || die "$name has empty runtime code"
    node - "$name" "$address" "$tx" "$gas_limit" "$gas" "$result" <<'NODE'
const [name,address,transactionHash,gasLimit,gasUsed,raw] = process.argv.slice(2);
console.log(JSON.stringify({name,address,transactionHash,gasLimit,gasUsed,raw:JSON.parse(require('fs').readFileSync(raw))}));
NODE
}

VERIFIER="$(deploy verifier "$VERIFIER_GAS_LIMIT" 'node_modules/@semaphore-protocol/contracts/base/SemaphoreVerifier.sol:SemaphoreVerifier')"
VERIFIER_ADDRESS="$(node -e 'console.log(JSON.parse(process.argv[1]).address)' "$VERIFIER")"
SEMAPHORE="$(deploy semaphore "$SEMAPHORE_GAS_LIMIT" 'node_modules/@semaphore-protocol/contracts/Semaphore.sol:Semaphore' "$VERIFIER_ADDRESS")"
SEMAPHORE_ADDRESS="$(node -e 'console.log(JSON.parse(process.argv[1]).address)' "$SEMAPHORE")"
REGISTRY="$(deploy registry "$REGISTRY_GAS_LIMIT" 'src/MerkleRootRegistryZK.sol:MerkleRootRegistryZK' "$SEMAPHORE_ADDRESS")"
REGISTRY_ADDRESS="$(node -e 'console.log(JSON.parse(process.argv[1]).address)' "$REGISTRY")"
[[ "${REGISTRY_ADDRESS,,}" != "${SEMAPHORE_ADDRESS,,}" ]] || die 'registry address is invalid'
[[ "${SEMAPHORE_ADDRESS,,}" != "${VERIFIER_ADDRESS,,}" ]] || die 'semaphore address is invalid'
[[ "${VERIFIER_ADDRESS,,}" == "$("$CAST" call "$SEMAPHORE_ADDRESS" 'verifier()(address)' --rpc-url "$RPC_URL")" ]] || die 'Semaphore verifier wiring is invalid'
[[ "${SEMAPHORE_ADDRESS,,}" == "$("$CAST" call "$REGISTRY_ADDRESS" 'semaphore()(address)' --rpc-url "$RPC_URL")" ]] || die 'Registry Semaphore wiring is invalid'
node - "$OUTPUT" "$CHAIN_ID" "$RPC_URL" "$DEPLOYER" "$VERIFIER" "$SEMAPHORE" "$REGISTRY" <<'NODE'
const [output,chainId,rpcUrl,deployer,verifier,semaphore,registry] = process.argv.slice(2);
const host = new URL(rpcUrl).host;
const deployments = [verifier,semaphore,registry].map(JSON.parse);
require('fs').writeFileSync(output, JSON.stringify({schema:1,chainId:Number(chainId),rpcHost:host,deployer,operationalGasCeiling:20000000,deployments,verifier:deployments[0].address,semaphore:deployments[1].address,registry:deployments[2].address,wiring:{semaphoreVerifier:deployments[0].address,registrySemaphore:deployments[1].address}}));
NODE
